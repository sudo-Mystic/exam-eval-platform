# Faculty auth: single shared token for the MVP (no RBAC).
# Required before exposing to the college network. Unset = dev mode (open API).
FACULTY_TOKEN=""

# Database: PostgreSQL connection string
DATABASE_URL="postgresql://exam:exam@localhost:5432/exam_eval"

# Gemini API (server-side only, never exposed to frontend)
GEMINI_API_KEY=""
# Configurable model routing - change without code edits
GEMINI_MODEL_LIGHT="gemini-2.0-flash"
GEMINI_MODEL_CAPABLE="gemini-2.5-pro"
# Token budgets per exam (0 = unlimited)
EXAM_TOKEN_BUDGET_PROMPT=0
EXAM_TOKEN_BUDGET_OUTPUT=0

# Storage: local disk (free). Set STORAGE_BACKEND=s3 for S3-compatible later
STORAGE_BACKEND="local"
STORAGE_DIR="./storage/uploads"

# App
NEXTAUTH_SECRET="change-me-in-production"
APP_URL="http://localhost:3000"

# Job worker
WORKER_CONCURRENCY=4
WORKER_POLL_MS=2000
